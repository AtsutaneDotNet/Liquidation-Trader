# Server Configuration
WEB_HOST=localhost
WEB_PORT=3000

# Application Configuration
LOG_LEVEL=info # Set to 'debug' to see verbose logs like individual liquidation streams

# Security Key for Local SQLite Database Encryption (AES-256-GCM)
# Must be exactly 32 bytes (64 hex characters)
# To generate one quickly, run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Generate this BEFORE first run. Do NOT change it later or database access will be lost.
ENCRYPTION_KEY=
ENABLE_REVERSE_LIQUIDATION_STRATEGY=false
